publish/
Publish/
*.Publish.xml

# Logs and reports
*.log
smoke_report.txt

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Test results
TestResults/
*.trx

# Temporary files
*.tmp
*.temp

# Runtime / generated files
*.deps.json
*.runtimeconfig.json
runtimes/

# Dotnet tool test helpers
.vscode-test/
